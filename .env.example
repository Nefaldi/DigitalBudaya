# Database Configuration (PostgreSQL / Supabase)
# DATABASE_URL: Menggunakan connection pooler (port 6543 / PgBouncer)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Koneksi langsung ke instance database (port 5432) untuk migrasi Prisma
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication Secrets (Mendukung JWT_SECRET atau AUTH_SECRET)
JWT_SECRET="super-secret-jwt-token-key-change-this-in-production-2026"
AUTH_SECRET="super-secret-jwt-token-key-change-this-in-production-2026"

